# Wave Electronics frontend - environment configuration
# Copy this file to .env and fill in real values if needed. Never commit the
# real .env file.

# Optional. Base URL of the backend API, including the /api prefix.
# Leave unset for a same-origin deployment (the default '/api' relative
# path is used, matching the dev proxy in vite.config.ts). Set this only
# when the frontend and backend are hosted on different origins, e.g.:
# VITE_API_URL=https://api.example.com/api
VITE_API_URL=
