# Wave Electronics API server - environment configuration
# Copy this file to .env and fill in real values. Never commit the real .env
# file (it is already gitignored).

# ---------------------------------------------------------------------------
# Required in every environment
# ---------------------------------------------------------------------------

# Port the API server listens on.
PORT=5000

# development | production | test
# In production, this gates several mandatory checks below - the server
# refuses to start if they are not satisfied.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Required in production (optional in development - safe defaults are used)
# ---------------------------------------------------------------------------

# MongoDB connection string. MUST point at a transaction-capable replica set
# in production (even a single-node replica set) - stock reservation,
# material issue, and receipt processing all require multi-document ACID
# transactions. The server refuses to start in production without this set,
# and separately refuses to start if the connected deployment turns out not
# to be a replica set.
# Development default if unset: mongodb://127.0.0.1:27017/wave_electronics_dev
#
# Use a database per environment, each with its own Atlas user that can only
# reach that database: wave_electronics_dev here on your machine,
# wave_electronics_preview and wave_electronics (production) only in Vercel.
# A development server refuses any database whose name does not end in
# _dev, _test or _preview (unless it is on this machine). Never put the
# production connection string in this file. Check with: npm run env:check
MONGODB_URI=

# Secret used to sign and verify JWT auth tokens. MUST be set in production,
# and MUST be at least 32 random characters - the server refuses to start
# otherwise. Generate one with, e.g.: openssl rand -hex 32
# There is no hardcoded fallback - do not reuse any example/sample value.
JWT_SECRET=

# Comma-separated list of trusted frontend origins allowed to call this API
# (CORS). MUST be set in production - no wildcard, no silent allow-all.
# Example: https://app.example.com,https://admin.example.com
# In development, if left unset, all origins are allowed (unrestricted),
# matching the previous local dev behavior.
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Optional - PDF document branding
# ---------------------------------------------------------------------------

# Company address printed on generated Delivery Challan / Job Receipt PDFs.
# Omitted entirely from the PDF if unset (never fabricated).
COMPANY_ADDRESS=

# Company GSTIN printed on generated PDFs. Omitted if unset.
COMPANY_GSTIN=

# Absolute path to a company logo image file, drawn on generated PDFs.
# If unset or missing, server/assets/company-logo.png is used when present
# (the only option on Vercel); with neither, the PDF header is text-only.
COMPANY_LOGO_PATH=
